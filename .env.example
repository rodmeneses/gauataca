# Copy to .env.local and fill in your Supabase project values.
# Without these, the app runs in demo mode (read-only mock data).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys --json
# Public key -> VITE_VAPID_PUBLIC_KEY (client bundle, must match the server key).
VITE_VAPID_PUBLIC_KEY=
# Server-only (Vercel env vars — never VITE_*): send the same VAPID keypair plus
# a SUPABASE_SERVICE_ROLE_KEY (dashboard → Settings → API) for api/notify.ts.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@gauataca.vercel.app
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
